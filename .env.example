# Terra Atlas Environment Variables
# Copy this file to .env.local and fill in your actual values

# ====================
# DATABASE
# ====================
# PostgreSQL database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/terra_atlas

# ====================
# SUPABASE
# ====================
# Supabase project URL (get from Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public, safe to expose to client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (PRIVATE - never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ====================
# AUTHENTICATION
# ====================
# JWT secret for signing tokens (generate a strong random string)
# Example: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-minimum-32-characters-long

# ====================
# STRIPE PAYMENTS
# ====================
# Stripe publishable key (public, safe to expose to client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Stripe secret key (PRIVATE - never expose to client!)
STRIPE_SECRET_KEY=sk_test_your-secret-key

# Stripe webhook secret for verifying webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ====================
# APPLICATION URLs
# ====================
# Base URL for your application (used in redirects, webhooks, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# WebSocket URL for real-time updates
NEXT_PUBLIC_WS_URL=ws://localhost:8002/ws

# ML Backend URL for AI-powered features
NEXT_PUBLIC_ML_BACKEND_URL=http://localhost:8001

# ====================
# ANALYTICS (Optional)
# ====================
# Google Tag Manager ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics domain
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# ====================
# EXTERNAL APIs (Optional)
# ====================
# Mapbox access token for map features
MAPBOX_TOKEN=pk.your-mapbox-token

# Planet Labs API key for satellite imagery
PLANET_API_KEY=your-planet-api-key

# US Energy Information Administration API key
EIA_API_KEY=your-eia-api-key

# National Renewable Energy Laboratory API key
NREL_API_KEY=your-nrel-api-key

# ====================
# DEVELOPMENT
# ====================
# Node environment (development, production, test)
NODE_ENV=development
